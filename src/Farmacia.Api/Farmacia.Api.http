@Farmacia.Api_HostAddress = http://localhost:5228

GET {{Farmacia.Api_HostAddress}}/health

###

# ---------- Auth (development users, password in appsettings.Development.json) ----------

# @name login
# Expect 200: access token in the body, refresh token in an HttpOnly cookie (the client stores it automatically).
POST {{Farmacia.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{ "email": "dueno@farmacia.dev", "password": "Farmacia2026" }

###

# Who the access token belongs to. Expect 200 (401 without the header).
GET {{Farmacia.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# New access token + new refresh cookie. Sending this one twice with the same old cookie revokes the session.
POST {{Farmacia.Api_HostAddress}}/api/auth/refresh

###

# Ends the session: expect 204 and the cookie removed.
POST {{Farmacia.Api_HostAddress}}/api/auth/logout

###

# ---------- Products (send the login request above first: they use its access token) ----------

# @name createProduct
# Creates a product sold by box, blister and tablet. Expect 201 with a Location header.
POST {{Farmacia.Api_HostAddress}}/api/products
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Acetaminofén 500 mg",
  "baseUnitName": "Tableta",
  "requiresPrescription": false,
  "activeIngredient": "Acetaminofén",
  "concentration": "500 mg",
  "pharmaceuticalForm": "Tableta",
  "sanitaryRegistration": "INVIMA 2020M-0012345",
  "categoryId": null,
  "saleUnits": [
    { "name": "Caja x30", "conversionFactor": 30, "price": 12000, "barcode": "7702057000017" },
    { "name": "Blíster", "conversionFactor": 10, "price": 4500, "barcode": null },
    { "name": "Tableta", "conversionFactor": 1, "price": 500, "barcode": null }
  ]
}

###

# Reads the product just created (uses the Location header of the previous request).
GET {{createProduct.response.headers.Location}}
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# Same barcode again. Expect 409 Conflict.
POST {{Farmacia.Api_HostAddress}}/api/products
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Otro producto",
  "baseUnitName": "Tableta",
  "requiresPrescription": false,
  "saleUnits": [
    { "name": "Caja x30", "conversionFactor": 30, "price": 12000, "barcode": "7702057000017" }
  ]
}

###

# Breaks a domain rule (conversion factor 0). Expect 400 with the domain message.
POST {{Farmacia.Api_HostAddress}}/api/products
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Ibuprofeno 400 mg",
  "baseUnitName": "Tableta",
  "requiresPrescription": false,
  "saleUnits": [
    { "name": "Caja", "conversionFactor": 0, "price": 9000 }
  ]
}

###

# Unknown product. Expect 404.
GET {{Farmacia.Api_HostAddress}}/api/products/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# ---------- Catalog (as the owner or the stock keeper) ----------

# The catalog with stock: sellable and expired units, nearest expiration. includeInactive shows discontinued ones too.
GET {{Farmacia.Api_HostAddress}}/api/products/catalog?includeInactive=true
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# A product's batches, the first to expire first, with their cost (a cashier gets 403).
GET {{Farmacia.Api_HostAddress}}/api/products/{{createProduct.response.body.$.id}}/batches
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# A new price for a presentation: the next sales charge it; past tickets keep theirs. Expect 204.
# Get the sale unit Id with GET /api/products/{id}.
PUT {{Farmacia.Api_HostAddress}}/api/products/{{createProduct.response.body.$.id}}/sale-units/{{saleUnitId}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "name": "Caja x30", "conversionFactor": 30, "price": 13000, "barcode": null }

###

# Discontinue it: no longer in the POS search, not sold, not bought. /activate brings it back.
POST {{Farmacia.Api_HostAddress}}/api/products/{{createProduct.response.body.$.id}}/deactivate
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# ---------- Inventory (as the owner or the stock keeper) ----------
# Get a batch Id with GET /api/products/{id}/batches.
@batchId = 00000000-0000-0000-0000-000000000000

# Write off an expired batch: all its units. One that has not expired yet: 400 "no está vencido".
POST {{Farmacia.Api_HostAddress}}/api/batches/{{batchId}}/write-off
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# Set a batch to what was counted on the shelf (base units), with the reason. Expect 204.
POST {{Farmacia.Api_HostAddress}}/api/batches/{{batchId}}/adjust
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "countedQuantity": 38, "reason": "Dos tabletas dañadas" }

###

# The product's kardex, newest first: lot, document, who, and the product's balance after each movement.
GET {{Farmacia.Api_HostAddress}}/api/products/{{createProduct.response.body.$.id}}/kardex
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# ---------- Purchases (log in above as dueno@ or bodega@; a cashier gets 403) ----------
# Fill these with Ids from your database (the dev seeder creates "Distribuidora de Desarrollo"):
#   SELECT Id FROM Suppliers;   SELECT Id, ProductId, Name FROM SaleUnits;
@supplierId = 00000000-0000-0000-0000-000000000000
@productId = 00000000-0000-0000-0000-000000000000
@saleUnitId = 00000000-0000-0000-0000-000000000000

# @name createPurchase
# A draft. Each later action is saved at once, so a power cut loses nothing. Expect 201.
POST {{Farmacia.Api_HostAddress}}/api/purchases
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "supplierId": "{{supplierId}}",
  "invoiceNumber": "FE-0001",
  "invoiceDate": "2026-10-23",
  "paymentTerm": "Credit",
  "dueDate": "2026-11-22"
}

###

# 10 boxes x30 at 9.000, 2 bonus boxes, 3.000 line discount: 87.000 for 360 tablets. Expect 201.
POST {{createPurchase.response.headers.Location}}/items
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "saleUnitId": "{{saleUnitId}}",
  "quantity": 10,
  "bonusQuantity": 2,
  "unitCost": 9000,
  "lineDiscount": 3000,
  "vatRate": "Exempt",
  "lotNumber": "LOTE-0001",
  "expirationDate": "2027-06-30"
}

###

# The draft with its totals.
GET {{createPurchase.response.headers.Location}}
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# Drafts left half-typed (e.g. by a power cut).
GET {{Farmacia.Api_HostAddress}}/api/purchases?status=Draft
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# Wrong printed total: expect 400 with the difference ($3.000).
POST {{createPurchase.response.headers.Location}}/confirm
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "printedInvoiceTotal": 90000 }

###

# Right total: expect 200; the batch enters the inventory at 241,6667 per tablet.
POST {{createPurchase.response.headers.Location}}/confirm
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "printedInvoiceTotal": 87000 }

### ---------- Cash register (as the cashier) ----------

# @name loginCashier
POST {{Farmacia.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{ "email": "cajero@farmacia.dev", "password": "Farmacia2026" }

###

# The open shift (expectedCash is null for the cashier: blind count), or null and the suggested float.
GET {{Farmacia.Api_HostAddress}}/api/cash-sessions/current
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}

###

# @name openShift
POST {{Farmacia.Api_HostAddress}}/api/cash-sessions
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}
Content-Type: application/json

{ "openingFloat": 100000 }

###

# A delivery paid from the drawer.
POST {{Farmacia.Api_HostAddress}}/api/cash-sessions/current/movements
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}
Content-Type: application/json

{ "type": "Expense", "amount": 8000, "reason": "Domicilio" }

###

# Sell 2 boxes (24.000): 10.000 by card and 20.000 in cash. Expect 201 with the ticket: number, change 6.000.
# Uses @productId and @saleUnitId from the purchases section (the confirmed purchase gave them stock).
# @name sell
POST {{Farmacia.Api_HostAddress}}/api/sales
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}
Content-Type: application/json

{
  "lines": [{ "productId": "{{productId}}", "saleUnitId": "{{saleUnitId}}", "quantity": 2 }],
  "payments": [{ "method": "Card", "amount": 10000 }, { "method": "Cash", "amount": 20000 }],
  "prescriptionChecked": false
}

###

# The ticket again, to reprint it.
GET {{Farmacia.Api_HostAddress}}/api/sales/{{sell.response.body.$.id}}
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}

###

# The shift's sales, newest first.
GET {{Farmacia.Api_HostAddress}}/api/sales?cashSessionId={{openShift.response.body.$.id}}
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}

###

# A return starts with the number printed on the ticket. Each line shows returnedQuantity.
GET {{Farmacia.Api_HostAddress}}/api/sales/by-number/{{sell.response.body.$.number}}
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}

###

# Return 1 of the 2 boxes, back into its batch ("Discard" if opened or damaged). Expect 201 with the voucher:
# refund 12.000 in cash from this shift. Returning more than is left: 400 "solo quedan…".
# @name saleReturn
POST {{Farmacia.Api_HostAddress}}/api/sale-returns
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}
Content-Type: application/json

{
  "saleId": "{{sell.response.body.$.id}}",
  "reason": "Le formularon otro medicamento",
  "lines": [{ "saleItemId": "{{sell.response.body.$.items[0].id}}", "quantity": 1, "disposition": "Restock" }]
}

###

# The voucher again, to reprint it.
GET {{Farmacia.Api_HostAddress}}/api/sale-returns/{{saleReturn.response.body.$.id}}
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}

###

### ---------- Credit ("fiado"): the owner decides, the cashier sells and receives payments ----------

# The owner registers the customer (a cashier gets 403). A repeated document: 409.
# @name createCustomer
POST {{Farmacia.Api_HostAddress}}/api/customers
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "fullName": "Doña Rosa", "documentType": "CitizenshipCard", "documentNumber": "41234567", "phone": "3001234567" }

###

# ...and enables credit with a limit of 50.000. Expect 201.
POST {{Farmacia.Api_HostAddress}}/api/customers/{{createCustomer.response.body.$.id}}/credit
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "limit": 50000 }

###

# The cashier finds the customer (by name or document) and sees what is available.
GET {{Farmacia.Api_HostAddress}}/api/customers?search=41234567
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}

###

# 1 box on credit. Over the limit: 400 "tiene disponibles…"; a customer without credit: 400.
POST {{Farmacia.Api_HostAddress}}/api/sales
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}
Content-Type: application/json

{
  "lines": [{ "productId": "{{productId}}", "saleUnitId": "{{saleUnitId}}", "quantity": 1 }],
  "payments": [{ "method": "Credit", "amount": 12000 }],
  "prescriptionChecked": false,
  "customerId": "{{createCustomer.response.body.$.id}}"
}

###

# A payment ("abono") of 5.000 in cash: it enters this shift's drawer. The voucher says what is still owed (7.000).
POST {{Farmacia.Api_HostAddress}}/api/credit-payments
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}
Content-Type: application/json

{ "customerId": "{{createCustomer.response.body.$.id}}", "method": "Cash", "amount": 5000 }

###

# The customer's statement, newest first.
GET {{Farmacia.Api_HostAddress}}/api/customers/{{createCustomer.response.body.$.id}}/credit
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}

###

# The owner's list of who owes, the oldest debt first.
GET {{Farmacia.Api_HostAddress}}/api/customers/debtors
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# Close with the cash counted by hand: the answer shows the expected cash (92.000, plus 14.000 if you ran the sale
# above, minus 12.000 if you ran the return, plus 5.000 if you ran the credit payment) and the difference.
POST {{Farmacia.Api_HostAddress}}/api/cash-sessions/{{openShift.response.body.$.id}}/close
Authorization: Bearer {{loginCashier.response.body.$.accessToken}}
Content-Type: application/json

{ "countedCash": 90000, "notes": "Faltaron 2.000" }
