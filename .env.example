# Copy to .env (ignored by git). Local values only: production secrets live in Azure Key Vault.

# SQL Server requires 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

# Only for `docker compose --profile app up` (the whole app in a container).
# 32+ random bytes in base64, e.g.: openssl rand -base64 32   (or PowerShell: [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256})))
JWT_SIGNING_KEY=
# The first platform administrator, created on the first start; the password must be changed at the first login.
BOOTSTRAP_ADMIN_EMAIL=admin@farmacia.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe2026
# Optional: MediatR Community license key (without it MediatR only logs a warning).
MEDIATR_LICENSE_KEY=
